# ---------------------------------------------------------------------------
# Database runtime URL. The backend uses this at runtime. In production this
# may be a pooled connection string, e.g. PgBouncer/Supavisor.
DATABASE_URL="postgresql://justdoit:justdoit@localhost:5432/justdoit?schema=public"

# Direct database URL for Prisma CLI commands such as migrate deploy.
# In local development this can match DATABASE_URL. In production this should
# bypass PgBouncer/transaction poolers.
DIRECT_DATABASE_URL="postgresql://justdoit:justdoit@localhost:5432/justdoit?schema=public"

# Full-stack Docker Compose sets both URLs to the container-internal Postgres:
# postgresql://justdoit:justdoit@postgres:5432/justdoit?schema=public

# ---------------------------------------------------------------------------
# Backend (NestJS)
PORT=3001
# Comma-separated list of allowed CORS origins for the browser frontend
CORS_ORIGIN="http://localhost:3000"

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# Used by browser-side Axios calls:
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Used by Next.js server components / SSR data fetching.
# Locally this is the same host; in Docker it would be e.g. http://backend:3001
API_INTERNAL_URL="http://localhost:3001"
